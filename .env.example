# TGTC READY v1.3 — free multi-source production environment template
# Never commit real credentials or the production signing key.

# ---------- Required credentials ----------
APOLLO_API_KEY=
HUNTER_API_KEY=
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Leads
INSTANTLY_API_KEY=
VALIDATION_SIGNING_KEY=replace-with-a-long-random-secret

# ---------- Instantly campaign routing ----------
INSTANTLY_CAMPAIGN_ID=
INSTANTLY_CAMPAIGN_GTM=
INSTANTLY_CAMPAIGN_ENGINEERING=
INSTANTLY_CAMPAIGN_MARKETING=
INSTANTLY_CAMPAIGN_CUSTOMER_SUCCESS=
INSTANTLY_CAMPAIGN_CUSTOMER_SUPPORT=
INSTANTLY_CAMPAIGN_PEOPLE_HR=
INSTANTLY_CAMPAIGN_FINANCE=
INSTANTLY_CAMPAIGN_OPERATIONS=
INSTANTLY_CAMPAIGN_PRODUCT=
INSTANTLY_CAMPAIGN_ECOMMERCE=

# ---------- Outbound Wave 1 A/B experiment ----------
# Control A is the live campaign copy and is untouched. Challenger B is
# rendered locally and delivered as Instantly custom variables.
# With OUTBOUND_WAVE1_ENABLED=0 the enrollment payload is identical to today's.
OUTBOUND_WAVE1_ENABLED=0
OUTBOUND_WAVE1_EXPERIMENT_ID=outbound_wave1_challenger_v1
# Share of ACCOUNTS routed to the challenger. 0 keeps everyone on Control A.
OUTBOUND_WAVE1_B_SPLIT_PCT=0
# Must stay fixed for the life of the experiment; changing it reshuffles every account.
OUTBOUND_WAVE1_ASSIGNMENT_SALT=
OUTBOUND_WAVE1_CLAIM_REGISTRY_PATH=
# REQUIRED when OUTBOUND_WAVE1_ENABLED=1. Experiment start watermark: only
# Airtable rows created at or after this instant may enter Wave 1, which keeps
# the pilot to genuinely new leads instead of Approved rows for people the live
# Control campaigns may already have emailed. Blank or unparseable = everything
# stays on Control A (fail closed). ISO-8601, e.g. 2026-09-08T00:00:00Z.
OUTBOUND_WAVE1_MIN_RECORD_CREATED_AT=
# Challenger Instantly campaign ids by role bucket, e.g.
# {"finance":"<uuid>","marketing":"<uuid>"}. A bucket with no entry is OUT of the
# experiment entirely: those records stay on Control A and are suppressed from
# both arms rather than counted as control.
OUTBOUND_WAVE1_CHALLENGER_CAMPAIGNS_JSON={}

# ---------- Runtime / acquisition ----------
TZ=America/Merida
PRODUCTION=1
DEBUG_API_RESPONSES=0
REQUEST_TIMEOUT_SECONDS=45
MAX_HTTP_RETRIES=3

# Production acquisition: public feeds/ATS plus optional existing JSearch quota.
# No new account, approval, or paid source is required by this patch.
ACQUISITION_MODE=multi_source
MULTI_SOURCE_JSEARCH_ENABLED=1
MULTI_SOURCE_JSEARCH_OPTIONAL=1
MULTI_SOURCE_JSEARCH_TOPUP_ENABLED=1
FREE_JOB_SOURCES_JSON=["himalayas","jobicy","weworkremotely","remotive","remoteok"]
FREE_SOURCE_REQUEST_TIMEOUT_SECONDS=20
FREE_SOURCE_MAX_RESPONSE_CHARS=8000000
FREE_SOURCE_MAX_RECORDS_PER_SOURCE=1000
FREE_SOURCE_MIN_SUCCESSFUL_SOURCES=2
HIMALAYAS_PAGE_SIZE=20
HIMALAYAS_MAX_PAGES=25
HIMALAYAS_COMPANY_PROFILE_MAX_REQUESTS=30
HIMALAYAS_COMPANY_PROFILE_MAX_CONSECUTIVE_FAILURES=3
FREE_SOURCE_LANDING_DISCOVERY_ENABLED=1
FREE_SOURCE_LANDING_DISCOVERY_MAX_REQUESTS=40
ATS_DIRECT_ACQUISITION_ENABLED=1
ATS_BOARD_REFRESH_INTERVAL_HOURS=20
ATS_MAX_BOARDS_PER_RUN=150
ATS_MAX_JOBS_PER_BOARD=250
ATS_GREENHOUSE_DETAIL_MAX_REQUESTS_PER_BOARD=25
ATS_GREENHOUSE_DETAIL_MAX_REQUESTS_PER_RUN=100
ATS_WORKDAY_MAX_PAGES_PER_BOARD=5
ATS_WORKDAY_DETAIL_MAX_REQUESTS_PER_BOARD=25
ATS_WORKDAY_DETAIL_MAX_REQUESTS_PER_RUN=100
ATS_SMARTRECRUITERS_MAX_PAGES_PER_BOARD=3
ATS_SMARTRECRUITERS_DETAIL_MAX_REQUESTS_PER_BOARD=25
ATS_SMARTRECRUITERS_DETAIL_MAX_REQUESTS_PER_RUN=100
ATS_SHADOW_FORCE_REFRESH_MAX_BOARDS=25
ATS_REGISTRY_AUTO_SEED_HISTORY=1
ATS_REGISTRY_HISTORY_FILE_LIMIT=80
ATS_REGISTRY_MAX_HISTORY_FILE_BYTES=25000000

# Shared quality constraints.
PRIMARY_MAX_JOB_AGE_DAYS=14
RECOVERY_MIN_JOB_AGE_DAYS=15
RECOVERY_MAX_JOB_AGE_DAYS=30
AGE_RECOVERY_ENABLED=1
MAX_JOB_AGE_DAYS=14
REQUIRE_FULL_TIME_ROLES=1
REJECT_NON_ACTIVE_HIRING_SIGNALS=1
REQUIRE_EXPLICIT_US_REMOTE_SCOPE=1
ALLOW_PROVIDER_CONFIRMED_US_REMOTE=1
ALLOW_ACTIVE_GREENHOUSE_UNKNOWN_AGE_REVIEW=1
ALLOW_GLOBAL_REMOTE_US_INCLUSIVE_REVIEW=1
ALLOW_STRUCTURED_IDENTITY_CONFLICT_REVIEW=1
ROLE_ALLOW_SENIOR_IC=1

# JSearch is an optional companion source. RAPIDAPI_KEY may remain empty;
# public feeds and ATS continue if JSearch is unavailable or out of quota.
# Leave ROLES_JSON unset to use the bounded rollback acquisition catalog.
RAPIDAPI_KEY=
DATE_POSTED=month
COUNTRY=us
NUM_PAGES=1
SEARCH_DELAY_SECONDS=0.8
JSEARCH_MAX_QUERIES_PER_RUN=0
JSEARCH_MAX_ESTIMATED_UNITS_PER_RUN=150
JSEARCH_STOP_ON_LOW_QUOTA=1
JSEARCH_MIN_REMAINING_REQUESTS=500
JSEARCH_REMOTE_JOBS_ONLY=0
JSEARCH_REMOTE_FILTER_PARAMETER=work_from_home
JSEARCH_REMOTE_QUERY_BIAS=0
JSEARCH_LOOKBACK_QUERY_VARIANTS=["linkedin","indeed","glassdoor","hiring"]
JSEARCH_TOPUP_DATE_WINDOWS=["week","month"]
JSEARCH_ADAPTIVE_DEEPENING=1
JSEARCH_MAX_EXTRA_PAGES_PER_ROLE=1
JSEARCH_ADAPTIVE_MAX_EXTRA_QUERIES=32
JSEARCH_ADAPTIVE_MIN_PREFILTER_VIABLE=1
JSEARCH_ADAPTIVE_BUCKET_BALANCING=1
JSEARCH_ADAPTIVE_LOOKBACK=1
JSEARCH_ADAPTIVE_LOOKBACK_DATE_POSTED=month
JSEARCH_ADAPTIVE_LOOKBACK_MAX_QUERIES=16
JSEARCH_TARGET_PREFILTER_VIABLE=60

# ---------- READY architecture ----------
FINAL_PASS_PIPELINE_ENABLED=1
FINAL_PASS_TOPUP_ENABLED=1
VALIDATION_VERSION=tgtc-ready-v1.4.5-actionable-review
TARGET_FINAL_PASS_LEADS_PER_RUN=30
TARGET_REVIEWABLE_LEADS_PER_RUN=30
READY_INVENTORY_TARGET=30
READY_DAILY_DELIVERY_LIMIT=0
CONTINUE_AFTER_FINAL_PASS_TARGET=1
READY_INVENTORY_TTL_DAYS=2
PIPELINE_LOCK_STALE_HOURS=6
MAX_ELIGIBLE_COMPANIES_PER_RUN=0
FINAL_PASS_MICROBATCH_QUERY_UNITS=6
FINAL_PASS_MAX_TOPUP_ITERATIONS=2
MULTI_SOURCE_FINAL_PASS_MAX_TOPUP_ITERATIONS=0
FINAL_PASS_MAX_RUNTIME_SECONDS=1800
FINAL_PASS_MAX_EMPTY_QUERY_CYCLES=2
TOPUP_MAX_ZERO_DOWNSTREAM_BATCHES=2
MULTI_SOURCE_TOPUP_MAX_ZERO_DOWNSTREAM_BATCHES=4
DRIFT_AUDIT_SAMPLE_SIZE=10

# ---------- Job source verification ----------
JOB_SOURCE_FETCH_ENABLED=1
JOB_SOURCE_MAX_CANDIDATES=8
JOB_SOURCE_DIRECT_FIRST_ENABLED=1
JOB_SOURCE_DISCOVERY_MAX_PAGES=4
JOB_SOURCE_DISCOVERY_MAX_BOARD_PAGES=2
JOB_SOURCE_DISCOVERY_BUDGET_SECONDS=18
JOB_SOURCE_DISCOVERY_TIMEOUT_SECONDS=5
JOB_SOURCE_MAX_REDIRECTS=5
JOB_SOURCE_ATTEMPTS_PER_URL=1
JOB_SOURCE_TIMEOUT_SECONDS=8
JOB_SOURCE_FRESH_DIRECT_FALLBACK_ENABLED=1
JOB_SOURCE_FRESH_DIRECT_MAX_AGE_DAYS=30
JOB_SOURCE_FRESH_DIRECT_MIN_DESCRIPTION_CHARS=700
JOB_SOURCE_PROVIDER_STRUCTURED_REVIEW_ENABLED=1
JOB_SOURCE_PROVIDER_STRUCTURED_MAX_AGE_DAYS=30
JOB_SOURCE_PROVIDER_STRUCTURED_MIN_DESCRIPTION_CHARS=700
JOB_SOURCE_CACHE_TTL_HOURS=24
JOB_SOURCE_MAX_ACTIVE_AGE_DAYS=45
JOB_SOURCE_ALLOW_CORROBORATED=1
JOB_SOURCE_MIN_INDEPENDENT_PUBLISHERS=2
# Extend these JSON maps only for confirmed rebrands or legacy ATS tenants.
COMPANY_NAME_ALIASES_JSON={"magnitude software":"insightsoftware"}
COMPANY_DOMAIN_ALIASES_JSON={"magnitudesoftware.com":"insightsoftware.com"}

# ---------- Company evidence ----------
COMPANY_SOURCE_FETCH_ENABLED=1
COMPANY_SOURCE_MAX_PAGES=3
COMPANY_SOURCE_TIMEOUT_SECONDS=10
COMPANY_SOURCE_CACHE_TTL_HOURS=168
MIN_EMPLOYEES=25
MAX_EMPLOYEES=1000
REJECT_UNKNOWN_FIRMOGRAPHICS=1
ENFORCE_FOUNDED_BEFORE=0
FOUNDED_BEFORE_YEAR=2010
ENABLE_BROADER_INDUSTRY_EXCLUSIONS=1

# ---------- Enrichment ----------
VERIFY_WITH_HUNTER=1
APOLLO_MAX_PERSON_MATCH_ATTEMPTS_PER_BUCKET=3
HUNTER_MAX_FALLBACK_ATTEMPTS_PER_BUCKET=2
CONTACT_MAX_REROUTE_ATTEMPTS_PER_BUCKET=8
