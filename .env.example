FOUNDER_FALLBACK_MAX_EMPLOYEES=99

# ---------- Health / state ----------
MIN_JOBS_PER_RUN=10
MIN_ROLES_WITH_RESULTS=4
MAX_ROLE_FAILURES=3
MIN_HIRING_MANAGER_MATCH_RATE=0.70
ENFORCE_HM_MATCH_RATE=0
SEEN_JOBS_RETENTION_DAYS=30
AIRTABLE_SUPPRESS_EXISTING_COMPANY=1
APPROVED_REVALIDATION_MAX_AGE_HOURS=24
APPROVED_REVALIDATE_JOB_SOURCE=1
SLA_REQUIRE_NET_NEW_AIRTABLE=1
RECOVERABLE_JOB_TTL_DAYS=7
RECOVERABLE_JOB_MAX_ATTEMPTS=5
INSTANTLY_VERIFY_ON_IMPORT=0

# Railway lifecycle: commercial SLA misses remain exit code 0.
PIPELINE_FAIL_PROCESS_ON_SLA_MISS=0

# Railway startup guard: a deploy starts run_daily.py but must NOT execute the
# pipeline (or spend paid credits) unless autorun is explicitly enabled.
PIPELINE_AUTORUN_ENABLED=0

# Fantastic.jobs additive acquisition source (disabled by default). Set the API
# key only in the deployment secret store, never here.
FANTASTIC_JOBS_ENABLED=0
FANTASTIC_JOBS_API_KEY=
FANTASTIC_JOBS_BASE_URL=https://data.fantastic.jobs
FANTASTIC_JOBS_TIME_FRAME=24h
FANTASTIC_JOBS_REQUEST_TIMEOUT_SECONDS=30
FANTASTIC_JOBS_MAX_RETRIES=2
FANTASTIC_JOBS_MAX_JOBS_PER_RUN=400
FANTASTIC_JOBS_ATS_LIMIT=300
FANTASTIC_JOBS_WELLFOUND_LIMIT=50
FANTASTIC_JOBS_YCOMBINATOR_LIMIT=40
FANTASTIC_JOBS_LINKEDIN_LIMIT=10
FANTASTIC_JOBS_MIN_JOBS_QUOTA_REMAINING=90
FANTASTIC_JOBS_MIN_REQUESTS_QUOTA_REMAINING=20
FANTASTIC_JOBS_FAIL_OPEN=1
FANTASTIC_JOBS_DESCRIPTION_FORMAT=text
