# Secrets
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Runtime output
*.log
logs/*
!logs/.gitkeep
data/raw/*
data/filtered/*
data/enriched/*
data/state/*
data/replay/*
data/retrieval_measurement/*
*.corrupt.*

# Keep production inputs tracked
!data/exclusions/
!data/exclusions/crm_companies.csv
!data/validation/
!data/validation/.gitkeep

# Local/editor noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local archives
*.zip
data/orchestrator/
reports/jobs_enriched_*.json

# local operator artifacts (not for production commits)
/orchestrator.patch
/ROLLBACK_MANIFEST.json
data/logs/

# External acquisition batches. Provider exports are large and licensed; the
# pipeline reads them from disk and never needs them in version control.
imports/

# Orchestrator run state and artifacts. Runtime only, and the enriched lead
# rows / resume checkpoints carry contact PII -- they must stay local.
data/external_batch/
data/orchestrator_*/

# Operational run reports (write-ready leads, per-row outcomes). These carry
# contact PII and are deliberately kept local, matching existing practice.
reports/apify_batch_*/

# Generated weekly reports. Output of run_weekly_report.py, one pair of files
# per ISO week, regenerable from the run artifacts at any time -- committing
# them would churn the tree weekly and duplicate what production writes to the
# volume. Scoped deliberately: other reports/ audit artifacts stay trackable.
reports/weekly/

# Local recovery snapshots.
recovery_*/

# Outbound Wave 1 evidence artifacts.
#
# DENY BY DEFAULT, not file-by-file. Every artifact this workstream produces is
# read back from the live workspace, and several families embed material that
# must not enter the repository:
#
#   * the 33 live sender mailbox addresses, copied verbatim from the Control
#     campaigns into any captured campaign object (baselines, create/probe
#     responses, deregistration evidence);
#   * company names and hiring-manager first names, in the dry-run reviews.
#
# A one-file-at-a-time allowlist has already been outgrown once. The rule below
# covers the whole family, so a NEW artifact is ignored the moment it is
# written rather than the moment someone remembers to add it. No reports/wave1_*
# file is tracked today, so nothing is being un-tracked by this.
#
# To version a specific Wave 1 artifact deliberately, add an explicit negation
# BELOW this line and confirm first that the file carries no mailbox address,
# no lead email and no company/contact name:
#     !reports/wave1_<name>.json
reports/wave1_*

# Control reactivation evidence from the same workstream. These carry no mailbox
# address today -- only campaign ids, statuses, metrics and lead ids -- but they
# are generated run evidence, not source, and the naming does not start with
# wave1_ so the rule above would miss them.
reports/*control_activation*

# Anchor-conflict simulation artifacts (they carry real company text and
# record ids). The re-validation run before merge lands here too, so the
# rule covers the family rather than one filename.
reports/anchor_conflict_*.json

# Local dry-runs of run_maintenance write these under a corpus; they are not evidence.
acceptance/evidence/*/log_corpus/maintenance_backups/
acceptance/evidence/*/log_corpus/pending_work/
